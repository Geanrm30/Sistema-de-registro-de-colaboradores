<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="780.0" prefWidth="1050.0" spacing="12.0"
      focusTraversable="true"
      onKeyPressed="#manejarTeclado"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.sistema_de_registro_de_colaboradores.controller.RegistroController">

    <fx:define>
    </fx:define>

    <children>
        <MenuBar>
            <menus>
                <Menu text="Archivo">
                    <items>
                        <MenuItem text="Nuevo" onAction="#nuevoRegistro"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Salir" onAction="#salir"/>
                    </items>
                </Menu>

                <Menu text="Ayuda">
                    <items>
                        <MenuItem text="Acerca de" onAction="#mostrarAcercaDe"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <ToolBar>
            <items>
                <Button text="Guardar" onAction="#guardarColaborador"/>
                <Button text="Limpiar" onAction="#limpiarFormulario"/>
                <Button text="Eliminar" onAction="#eliminarColaborador"/>
            </items>
        </ToolBar>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="5.0" right="25.0" bottom="20.0" left="25.0"/>
            </padding>

            <children>

                <VBox spacing="3.0">
                    <Label text="Distribuidora El Güegüense">
                        <font>
                            <Font name="System Bold" size="22.0"/>
                        </font>
                    </Label>

                    <Label text="Registro de Colaboradores">
                        <font>
                            <Font name="System Bold" size="16.0"/>
                        </font>
                    </Label>
                </VBox>

                <Separator/>

                <HBox spacing="25.0" VBox.vgrow="ALWAYS">

                    <!-- Datos del colaborador -->
                    <GridPane hgap="12.0" vgap="11.0" HBox.hgrow="ALWAYS">

                        <columnConstraints>
                            <ColumnConstraints minWidth="160.0"/>
                            <ColumnConstraints minWidth="300.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nombres:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombres"
                                   promptText="Ingrese los nombres"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Apellidos:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="txtApellidos"
                                   promptText="Ingrese los apellidos"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Usuario:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="txtUsuario"
                                   promptText="Mínimo 5 caracteres"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>

                        <Label text="Contraseña temporal:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>

                        <PasswordField fx:id="txtContrasena"
                                       promptText="Mínimo 8 caracteres"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="3"/>

                        <Label text="Cargo:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="4"/>

                        <ComboBox fx:id="cmbCargo"
                                  maxWidth="Infinity"
                                  promptText="Seleccione un cargo"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="4"/>

                        <Label text="Área de trabajo:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="5"/>

                        <ListView fx:id="lstArea"
                                  prefHeight="85.0"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="5"/>

                        <Label text="Fecha de contratación:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="6"/>

                        <DatePicker fx:id="dpFechaContratacion"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="6"/>

                        <Label text="Tipo de contrato:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="7"/>

                        <HBox spacing="15.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="7">

                            <RadioButton fx:id="rbPermanente"
                                         text="Permanente"
                                         toggleGroup="$grupoContrato"/>

                            <RadioButton fx:id="rbTemporal"
                                         text="Temporal"
                                         toggleGroup="$grupoContrato"/>
                        </HBox>

                        <Label text="Beneficios:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="8"/>

                        <VBox spacing="5.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="8">

                            <CheckBox fx:id="chkSeguro"
                                      text="Seguro médico"/>

                            <CheckBox fx:id="chkAlimentacion"
                                      text="Alimentación"/>

                            <CheckBox fx:id="chkTransporte"
                                      text="Transporte"/>
                        </VBox>
                    </GridPane>
                    <VBox alignment="TOP_CENTER"
                          prefWidth="220.0"
                          spacing="10.0">

                        <StackPane prefHeight="180.0"
                                   prefWidth="210.0"
                                   style="-fx-border-color: #aaaaaa;
                                          -fx-border-radius: 5;
                                          -fx-background-color: #f2f2f2;">

                            <ImageView fx:id="imgInstitucional"
                                       fitHeight="170.0"
                                       fitWidth="200.0"
                                       preserveRatio="true"/>
                        </StackPane>
                    </VBox>
                </HBox>

                <Label text="Colaboradores registrados">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>
                <TableView fx:id="tablaColaboradores"
                           prefHeight="210.0"
                           onMouseClicked="#cargarFilaSeleccionada"
                           VBox.vgrow="ALWAYS">
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem text="Editar"
                                          onAction="#editarDesdeMenu"/>

                                <MenuItem text="Eliminar"
                                          onAction="#eliminarColaborador"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>

                    <columns>
                        <TableColumn fx:id="colNombre"
                                     prefWidth="180.0"
                                     text="Nombre completo"/>

                        <TableColumn fx:id="colCargo"
                                     prefWidth="120.0"
                                     text="Cargo"/>

                        <TableColumn fx:id="colArea"
                                     prefWidth="120.0"
                                     text="Área"/>

                        <TableColumn fx:id="colFecha"
                                     prefWidth="150.0"
                                     text="Fecha de contratación"/>

                        <TableColumn fx:id="colContrato"
                                     prefWidth="120.0"
                                     text="Contrato"/>

                        <TableColumn fx:id="colBeneficios"
                                     prefWidth="210.0"
                                     text="Beneficios"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">

                    <Button fx:id="btnGuardar"
                            prefWidth="110.0"
                            text="Guardar"
                            defaultButton="true"
                            onAction="#guardarColaborador"/>

                    <Button fx:id="btnActualizar"
                            prefWidth="110.0"
                            text="Actualizar"
                            onAction="#actualizarColaborador"/>

                    <Button fx:id="btnLimpiar"
                            prefWidth="110.0"
                            text="Limpiar"
                            cancelButton="true"
                            onAction="#limpiarFormulario"/>

                    <Button fx:id="btnEliminar"
                            prefWidth="110.0"
                            text="Eliminar"
                            onAction="#eliminarColaborador"/>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
